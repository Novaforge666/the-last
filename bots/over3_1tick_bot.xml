<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
  <variables>
    <variable id="v_stake">Stake</variable>
    <variable id="v_streak">LowStreak</variable>
    <variable id="v_tp">TakeProfit</variable>
    <variable id="v_sl">StopLoss</variable>
  </variables>

  <!-- ========== TRADE PARAMETERS ========== -->
  <block type="trade_definition" id="b_trade_def" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="b_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype" id="b_tradetype" deletable="false" movable="false">
            <field name="TRADETYPE_CATEGORY_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="b_contracttype" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITOVER</field>
                <next>
                  <block type="trade_definition_candleinterval" id="b_candle" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="b_restart_bs" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="b_restart_err" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- Initial values -->
    <statement name="INITIALIZATION">
      <block type="variables_set" id="b_init_stake">
        <field name="VAR" id="v_stake">Stake</field>
        <value name="VALUE">
          <block type="math_number"><field name="NUM">1</field></block>
        </value>
        <next>
          <block type="variables_set" id="b_init_streak">
            <field name="VAR" id="v_streak">LowStreak</field>
            <value name="VALUE">
              <block type="math_number"><field name="NUM">0</field></block>
            </value>
            <next>
              <block type="variables_set" id="b_init_tp">
                <field name="VAR" id="v_tp">TakeProfit</field>
                <value name="VALUE">
                  <block type="math_number"><field name="NUM">5</field></block>
                </value>
                <next>
                  <block type="variables_set" id="b_init_sl">
                    <field name="VAR" id="v_sl">StopLoss</field>
                    <value name="VALUE">
                      <block type="math_number"><field name="NUM">10</field></block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- Duration 1 tick, prediction 3 -->
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="b_tradeoptions">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number"><field name="NUM">1</field></shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number"><field name="NUM">1</field></shadow>
          <block type="variables_get" id="b_amount_var">
            <field name="VAR" id="v_stake">Stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number"><field name="NUM">3</field></shadow>
        </value>
      </block>
    </statement>
  </block>

  <!-- ========== BEFORE PURCHASE: entry pattern ========== -->
  <!-- Count consecutive ticks whose last digit is 0-3. Enter Over 3 after 3 in a row. -->
  <block type="before_purchase" id="b_before" deletable="false" x="0" y="700">
    <statement name="BEFORE_PURCHASE_STACK">
      <block type="controls_if" id="b_if_low">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare" id="b_cmp_low">
            <field name="OP">LTE</field>
            <value name="A">
              <block type="last_digit" id="b_lastdigit"></block>
            </value>
            <value name="B">
              <block type="math_number"><field name="NUM">3</field></block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="math_change" id="b_streak_inc">
            <field name="VAR" id="v_streak">LowStreak</field>
            <value name="DELTA">
              <block type="math_number"><field name="NUM">1</field></block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="b_streak_reset">
            <field name="VAR" id="v_streak">LowStreak</field>
            <value name="VALUE">
              <block type="math_number"><field name="NUM">0</field></block>
            </value>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="b_if_enter">
            <value name="IF0">
              <block type="logic_compare" id="b_cmp_enter">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR" id="v_streak">LowStreak</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number"><field name="NUM">3</field></block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="purchase" id="b_purchase">
                <field name="PURCHASE_LIST">DIGITOVER</field>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- ========== DURING PURCHASE ========== -->
  <block type="during_purchase" id="b_during" deletable="false" x="0" y="1200"></block>

  <!-- ========== AFTER PURCHASE: reset streak, flat stake, TP/SL ========== -->
  <block type="after_purchase" id="b_after" deletable="false" x="0" y="1350">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="b_after_reset">
        <field name="VAR" id="v_streak">LowStreak</field>
        <value name="VALUE">
          <block type="math_number"><field name="NUM">0</field></block>
        </value>
        <next>
          <block type="controls_if" id="b_if_limits">
            <value name="IF0">
              <block type="logic_operation" id="b_and">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="logic_compare">
                    <field name="OP">LT</field>
                    <value name="A">
                      <block type="total_profit"></block>
                    </value>
                    <value name="B">
                      <block type="variables_get">
                        <field name="VAR" id="v_tp">TakeProfit</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="total_profit"></block>
                    </value>
                    <value name="B">
                      <block type="math_single">
                        <field name="OP">NEG</field>
                        <value name="NUM">
                          <block type="variables_get">
                            <field name="VAR" id="v_sl">StopLoss</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="trade_again" id="b_trade_again"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
